# Required
AD_ENGINE_API_BASE_URL=https://ad-engine-api-610270819686.us-west1.run.app

# Optional: set this if your backend requires bearer auth for /api/ads or billing routes.
AD_ENGINE_API_TOKEN=
AD_ENGINE_API_TIMEOUT_SECONDS=20

# Endpoint overrides
SEARCH_VIDEO_ADS_PATH=/api/buyer/semantic-match
RANK_ADS_PATH=/api/buyer/semantic-match
ADS_LIST_PATH=/api/ads
GET_AD_BY_ID_PATH_TEMPLATE=/api/ads/{ad_id}

# Leave blank to use the built-in fallback explanation mode.
EXPLAIN_AD_MATCH_PATH=

SELLERS_LIST_PATH=/api/sellers
SELLER_BILLING_STATUS_PATH_TEMPLATE=/api/sellers/{seller_id}/billing-status
CREATE_BILLING_SUPPORT_TICKET_PATH=/api/billing/support-tickets
